{% extends 'base.html.twig' %}

{% block title %}Paiement annulé{% endblock %}

{% block body %}
<section class="checkout-bg" style="background-image: url('{{ asset('images/shop68.png') }}')">
    <div class="card bg-dark border-warning text-center" style="width: 100%; max-width: 500px;">
        <div class="card-body p-5">
            <h1 class="text-warning mb-3">⚠️ Paiement annulé</h1>
            <p>Votre commande n'a pas été finalisée. Votre panier a été conservé.</p>
            <a href="{{ path('cart_index') }}" class="btn btn-warning mt-3">Retour au panier</a>
        </div>
    </div>
</section>
{% endblock %}