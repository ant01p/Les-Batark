{% extends 'base.html.twig' %}

{% block title %}Accueil - ARK Community{% endblock %}

{% block body_class %}home-page{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block body %}

    <section class="bg" style="background-image: url('{{ asset('images/jungle.png') }}')">
        <div class="bg-overlay">
            <div class="container">
                <div class="overlay-content d-flex flex-column align-items-center text-white">
                    {{ include('_shared/_flash.html.twig') }}

                    <img src="{{ asset('images/LESBATARK.png') }}" alt="Logo BATARK" class="logo-batark">

                    <h1 class="hero-title">Bienvenue chez Les Batark !</h1>

                    <p>Rejoignez notre communauté de survivants et vivez l'aventure ARK comme jamais auparavant !</p>

                    <div class="hero-actions">
                        <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg hero-btn">
                            <i class="bi bi-person-plus"></i>Nous rejoindre
                        </a>
                        <a href="{{ path('app_servers') }}" class="btn btn-outline-light btn-lg hero-btn">
                            <i class="bi bi-hdd-network"></i>Voir les serveurs
                        </a>
                    </div>
                </div>
            </div>

            <div class="home-content-overlay mt-5 border-2">

                <section class="stats-section">
                    <div class="row g-3 g-md-4">
                        <div class="col-6 col-md-3">
                            <div class="content-card stat-card border border-2 border-secondary text-center">
                                <i class="bi bi-people-fill stat-icon"></i>
                                <div class="stat-value">{{ playerCount }}</div>
                                <div class="stat-label">Joueurs inscrits</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="content-card stat-card border border-2 border-secondary text-center">
                                <i class="bi bi-hdd-network stat-icon"></i>
                                <div class="stat-value">{{ serverCount }}</div>
                                <div class="stat-label">Serveurs</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="content-card stat-card border border-2 border-secondary text-center">
                                <i class="bi bi-calendar-event stat-icon"></i>
                                <div class="stat-value">{{ eventCount }}</div>
                                <div class="stat-label">Événements</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="content-card stat-card border border-2 border-secondary text-center">
                                <i class="bi bi-bag-fill stat-icon"></i>
                                <div class="stat-value">{{ productCount }}</div>
                                <div class="stat-label">Articles en boutique</div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="features-section">
                    <div class="section-label">Ce que nous offrons</div>
                    <h2 class="features-title">Découvrez nos fonctionnalités</h2>

                    <div class="row g-3 g-md-4 mt-2">
                        <div class="col-12 col-md-4">
                            <a href="{{ path('app_events') }}" class="feature-card-link d-block h-100 text-decoration-none text-reset">
                                <article class="content-card feature-card border border-2 border-info shadow-sm h-100">
                                    <div class="feature-icon feature-icon--events"><i class="bi bi-calendar-event"></i></div>
                                    <div class="card-title feature-card-title">Événements réguliers</div>
                                    <p class="card-desc feature-card-desc">Participez à des événements communautaires chaque semaine avec des récompenses exclusives.</p>
                                </article>
                            </a>
                        </div>
                        <div class="col-12 col-md-4">
                            <a href="{{ path('app_shop') }}" class="feature-card-link d-block h-100 text-decoration-none text-reset">
                                <article class="content-card feature-card border border-2 border-info shadow-sm h-100">
                                    <div class="feature-icon feature-icon--shop"><i class="bi bi-shop"></i></div>
                                    <div class="card-title feature-card-title">Boutique</div>
                                    <p class="card-desc feature-card-desc">Achetez des objets, des boosts et des skins exclusifs pour améliorer votre expérience de jeu.</p>
                                </article>
                            </a>
                        </div>
                        <div class="col-12 col-md-4">
                            <a href="{{ path('app_servers') }}" class="feature-card-link d-block h-100 text-decoration-none text-reset">
                                <article class="content-card feature-card border border-2 border-info shadow-sm h-100">
                                    <div class="feature-icon feature-icon--servers"><i class="bi bi-hdd-network"></i></div>
                                    <div class="card-title feature-card-title">Serveurs optimisés</div>
                                    <p class="card-desc feature-card-desc">Découvrez nos serveurs avec des paramètres personnalisés pour une expérience unique.</p>
                                </article>
                            </a>
                        </div>
                    </div>
                </section>

                <section>
                    <div class="news-panel" data-controller="news">
                        <div class="section-label">Quoi de neuf</div>
                        <h2 class="news-title"><i class="bi bi-newspaper"></i>Dernières actualités</h2>

                        {% if newsItems is empty %}
                            <p class="news-card-desc mb-0">Aucune actualité pour le moment.</p>
                        {% else %}
                            <div class="row g-3 g-md-4 mt-2">
                                {% for item in newsItems %}
                                    <div class="col-md-6" data-news-target="item">
                                        <a href="{{ item.url }}" class="d-block h-100 text-decoration-none text-reset">
                                            <article class="news-card content-card border border-2 border-success shadow-sm h-100">
                                                <span class="news-date">{{ item.dateLabel }}</span>
                                                <h3 class="news-card-title">{{ item.title }}</h3>
                                                <p class="news-card-desc">{{ item.description }}</p>
                                            </article>
                                        </a>
                                    </div>
                                {% endfor %}
                            </div>

                            {% if newsItems|length > 4 %}
                                <div class="text-center mt-3">
                                    <button type="button" class="btn btn-outline-light d-none" data-news-target="moreButton" data-action="news#showMore">Voir plus</button>
                                    <button type="button" class="btn btn-outline-light d-none" data-news-target="lessButton" data-action="news#showLess">Voir moins</button>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                </section>

            </div>
        </div>
    </section>

{% endblock %}
