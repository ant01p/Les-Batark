{% extends 'base.html.twig' %}

{% block title %}Accueil - ARK Community{% endblock %}

{% block body_class %}home-page{% endblock %}

{% block body %}

    <section class="home-page">

        <section class="bg" style="background-image: url('{{ asset('images/jungle.png') }}')">
        
            <div class="bg-overlay">
                <div class="container">
                    <div class="overlay-content ">
                        {{ include('_shared/_flash.html.twig') }}
                        <img src="{{ asset('images/LESBATARK.png') }}" alt="Logo ARK" class="logo-batark">
                        
                        <p>
                            Rejoignez notre cluster complet et vivez l'aventure ARK comme jamais auparavant!
                        </p>

                        <div class="d-flex gap-3 mt-4 mb-4">
                            <a href="{{path('app_shop')}}" class="btn btn-outline-success btn-lg">Voir la Boutique</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </section>
{% endblock %}