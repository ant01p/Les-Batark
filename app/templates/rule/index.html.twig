{% extends 'base.html.twig' %}

{% block title %}Règlement — Les Batark{% endblock %}

{% block body_class %}rules-page{% endblock %}

{% block body %}

<section class="bg" style="background-image: url('{{ asset('images/jungle.png') }}')">
    <div class="bg-overlay">
        <div class="container">

            <div class="page-header mb-5">
                <div class="text-center mb-3">
                    <img src="{{ asset('images/LESBATARK.png') }}"
                        alt="Logo LES-BATARK"
                        class="logo-batark"
                    >
                </div>

                <div class="page-title text-center">
                    <h1 class="text-white">
                        Règlement
                    </h1>
                </div>
            </div>

            <div class="card border-secondary content-card text-center py-5">
                <i class="bi bi-journal-text display-4 text-primary mb-3"></i>
                <p class="mb-4">Le règlement complet de la communauté est en cours de rédaction. Revenez très bientôt pour le consulter.</p>
                <a href="{{ path('app_home') }}" class="btn btn-outline-light">Retour à l'accueil</a>
            </div>

        </div>
    </div>
</section>

{% endblock %}
