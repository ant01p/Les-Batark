{% extends 'base.html.twig' %}

{% block title %}Mon panier — Les BATARK{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/product.css') }}">
{% endblock %}

{% block body_class %}events-page{% endblock %}

{% block body %}

<section class="bg" style="background-image: url('{{ asset('images/shop68.png') }}')">
    <div class="bg-overlay">
        <div class="container">

            <div class="row justify-content-center mb-4">
                <div class="col-lg-8">
                    <h1 class="text-white mt-4">Mon panier</h1>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-8">

                    {{ include('_shared/_flash.html.twig') }}

                    {% if cart.cartItems|length == 0 %}
                        <div class="card border-warning content-card">
                            <div class="card-body text-center">
                                <p class="mb-3">Ton panier est vide.</p>
                                <a href="{{ path('app_shop') }}" class="btn btn-outline-success">
                                    Retour à la boutique
                                </a>
                            </div>
                        </div>
                    {% else %}

                        {% for item in cart.cartItems %}
                            <div class="card border-warning content-card mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                                        <div class="d-flex align-items-start gap-3">
                                            {% set mainImage = item.product.mainImage %}
                                            {% if mainImage %}
                                                <img src="{{ asset('uploads/imageProduct/' ~ mainImage.filename) }}"
                                                    alt="{{ item.product.name }}"
                                                    class="cart-item-img"
                                                >
                                            {% endif %}

                                            <div>
                                                <span class="badge bg-secondary mb-1">{{ item.product.category.name }}</span>
                                                <div class="card-title mb-1">{{ item.product.name }}</div>

                                                {% if item.product.description %}
                                                    <p class="text-light small mb-2">{{ item.product.description }}</p>
                                                {% endif %}

                                                <div class="d-flex flex-column mb-2">
                                                    {% if item.type %}
                                                        <span class="text-light small">Type : {{ item.type.name }}</span>
                                                    {% endif %}
                                                    {% if item.quality %}
                                                        <span class="text-light small">Qualité : {{ item.quality.name }}</span>
                                                    {% endif %}
                                                    {% if item.sex %}
                                                        <span class="text-light small">Sexe : {{ item.sex }}</span>
                                                    {% endif %}
                                                    {% if item.version %}
                                                        <span class="text-light small">Version : {{ item.version }}</span>
                                                    {% endif %}
                                                    {% if item.stat %}
                                                        <span class="text-light small">Statistique : {{ item.stat }}</span>
                                                    {% endif %}
                                                    {% if item.option %}
                                                        <span class="text-light small">Option : {{ item.option }}</span>
                                                    {% endif %}
                                                    {% if item.color %}
                                                        <span class="text-light small">Couleur : {{ item.color }}</span>
                                                    {% endif %}
                                                </div>

                                                <p class="text-light fw-bold mb-0">
                                                    {{ (item.unitPrice / 100)|number_format(2, ',', ' ') }} € / unité
                                                </p>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-3">
                                            <form method="post" action="{{ path('cart_update_quantity', { id: item.id }) }}"
                                                class="d-flex align-items-center gap-2">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cart_update_quantity_' ~ item.id) }}">
                                                <input type="number" name="quantity" value="{{ item.quantity }}" 
                                                    min="0" class="form-control" style="width: 80px;"
                                                    onchange="this.form.submit()"
                                                >
                                            </form>

                                            <span class="fw-bold">
                                                {{ ((item.unitPrice * item.quantity) / 100)|number_format(2, ',', ' ') }} €
                                            </span>

                                            <form method="post" action="{{ path('cart_remove', { id: item.id }) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.id) }}">
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    Supprimer
                                                </button>
                                            </form>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        {% endfor %}

                        <div class="card border-success content-card">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="h4 mb-0 me-2">Total :</span>
                                    <span class="fs-2 fw-bold text-success">{{ (cart.total / 100)|number_format(2, ',', ' ') }} €</span>
                                </div>
                                <form action="{{ path('checkout_start') }}" method="post">
                                    <input type="hidden" name="_token" value="{{ csrf_token('checkout_start') }}">
                                    <button type="submit" class="btn btn-success btn-lg fs-4 px-5 py-3">
                                        Payer
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}