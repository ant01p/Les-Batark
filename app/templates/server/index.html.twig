{% extends 'base.html.twig' %}

{% block title %}Serveurs — Les Batark{% endblock %}

{% block body_class %}servers-page{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/server.css') }}">
{% endblock %}

{% block body %}

<section class="bg" style="background-image: url('{{ asset('images/jungle.png') }}')">
    <div class="bg-overlay">
        <div class="container">

            <div class="page-header mb-5">
                <div class="text-center mb-3">
                    <img src="{{ asset('images/LESBATARK.png') }}"
                        alt="Logo LES-BATARK"
                        class="logo-batark"
                    >
                </div>

                <div class="page-title">
                    <h1 class="text-white">
                        Nos Serveurs
                    </h1>

                    <p class="text-info mb-0">
                        {{ total }} serveur{{ total > 1 ? 's' : '' }} disponible{{ total > 1 ? 's' : '' }}
                    </p>
                </div>
            </div>

            {% if total == 0 %}
                <div class="card border-secondary content-card text-center py-5">
                    Aucun serveur configuré pour le moment. Revenez bientôt !
                </div>
            {% else %}
                <div data-controller="server-modal">
                    <div class="server-grid" data-server-modal-target="grid">
                        {% set previousMode = null %}
                        {% for server in servers %}
                            {% if server.gameMode != previousMode %}
                                <div class="section-label">{{ server.gameMode }}</div>
                                {% set previousMode = server.gameMode %}
                            {% endif %}
                            <div class="server-trigger"
                                role="button"
                                tabindex="0"
                                data-server-modal-target="trigger"
                                data-action="click->server-modal#open keydown.enter->server-modal#open keydown.space->server-modal#open"
                                data-server-modal-index-param="{{ loop.index0 }}">
                                {% include 'server/_server_card.html.twig' with {server: server, id_prefix: 'list'} %}
                            </div>
                        {% endfor %}
                    </div>

                    {% include 'server/_server_modal.html.twig' with {servers: servers} %}
                </div>
            {% endif %}

        </div>
    </div>
</section>

{% endblock %}
