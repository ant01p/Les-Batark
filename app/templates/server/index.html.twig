{% extends 'base.html.twig' %}

{% block title %}Serveurs — Les Batark{% endblock %}

{% block body_class %}servers-page{% endblock %}

{% block body %}

<section class="bg" style="background-image: url('{{ asset('images/jungle.png') }}')">
    <div class="bg-overlay">
        <div class="container">

            <div class="page-header mb-5">
                <div class="text-center mb-3">
                    <img src="{{ asset('images/LESBATARK.png') }}"
                        alt="Logo LES-BATARK"
                        class="logo-batark"
                    >
                </div>

                <div class="page-title">
                    <h1 class="text-white">
                        Nos Serveurs
                    </h1>

                    <p class="text-info mb-0">
                        {{ total }} serveur{{ total > 1 ? 's' : '' }} disponible{{ total > 1 ? 's' : '' }}
                    </p>
                </div>
            </div>

            {% if total == 0 %}
                <div class="card border-secondary content-card text-center py-5">
                    Aucun serveur configuré pour le moment. Revenez bientôt !
                </div>
            {% else %}
                {% for server in servers %}
                    {% set borderClass = server.gameMode == 'PVP' ? 'border-primary' : 'border-info' %}
                    <div class="card {{ borderClass }} content-card mb-3">
                        {% include 'server/_card.html.twig' with {server: server} %}
                    </div>
                {% endfor %}
            {% endif %}

        </div>
    </div>
</section>

{% endblock %}
