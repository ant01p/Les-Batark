{% macro modal(id, title, body, formId, confirmLabel, confirmClass) %}
    {% set confirmLabel = confirmLabel|default('Confirmer') %}
    {% set confirmClass = confirmClass|default('danger') %}
    <div class="modal fade" id="{{ id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ title }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer">
                        <span aria-hidden="true"></span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">{{ body }}</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" form="{{ formId }}" class="btn btn-{{ confirmClass }}">{{ confirmLabel }}</button>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}
