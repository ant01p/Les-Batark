<script>
    document.addEventListener('click', function (event) {
        var btn = event.target.closest('.password-toggle-btn');
        if (!btn) {
            return;
        }

        var input = document.getElementById(btn.dataset.passwordToggle);
        if (!input) {
            return;
        }

        var willShow = input.type === 'password';
        input.type = willShow ? 'text' : 'password';

        var icon = btn.querySelector('i');
        icon.classList.toggle('bi-eye', !willShow);
        icon.classList.toggle('bi-eye-slash', willShow);

        btn.setAttribute('aria-label', willShow ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
    });
</script>
