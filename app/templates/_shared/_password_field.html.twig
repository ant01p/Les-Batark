{#
    Champ mot de passe avec bouton oeil (afficher/masquer).
    Usage :
        {% import '_shared/_password_field.html.twig' as ui %}
        {% set password_input %}
            <input type="password" id="my_id" name="my_name" class="password form-control">
        {% endset %}
        {{ ui.field(password_input, 'my_id') }}
#}
{% macro field(input_html, toggle_id) %}
    <div class="password-field">
        {{ input_html }}
        <button type="button"
                class="password-toggle-btn"
                data-password-toggle="{{ toggle_id }}"
                aria-label="Afficher le mot de passe"
                tabindex="-1"
        >
            <i class="bi bi-eye" aria-hidden="true"></i>
        </button>
    </div>
{% endmacro %}
