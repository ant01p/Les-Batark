{% extends 'base.html.twig' %}

{% block title %}Créer un compte - LES-BATARK{% endblock %}

{% block body %}

<div class="auth-frame">
    <div class="auth-bg" style="background-image: url('{{ asset('images/abe.jpg') }}')">
        <div class="auth-card border-dark">
           
            <div class="card-header text-center">
                <h2>Créer un compte</h2>
            </div>

            {{ form_start(registrationForm, {
                'attr': {
                    'data-turbo': 'false'
                }
            }) }}

                <div class="mb-3">
                    {{ form_label(registrationForm.pseudo) }}
                    {{ form_widget(registrationForm.pseudo, {
                        'attr': {
                            'class': 'pseudo form-control',
                            'placeholder': 'Choisissez un pseudo'
                        }
                    }) }}
                    {{ form_errors(registrationForm.pseudo) }}
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.email) }}
                    {{ form_widget(registrationForm.email, {
                        'attr': {
                            'class': 'email form-control',
                            'placeholder': 'Entrez votre email'
                        }
                    }) }}
                    {{ form_errors(registrationForm.email) }}
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.plainPassword) }}
                    {{ form_widget(registrationForm.plainPassword, {
                        'attr': {
                            'class': 'password form-control',
                            'placeholder': 'Créez un mot de passe'
                        }
                    }) }}
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>

                {% if registrationForm.confirmPassword is defined %}
                    <div class="mb-3">
                        {{ form_label(registrationForm.confirmPassword) }}
                        {{ form_widget(registrationForm.confirmPassword, {
                            'attr': {
                                'class': 'password form-control',
                                'placeholder': 'Confirmez votre mot de passe'
                            }
                        }) }}
                        {{ form_errors(registrationForm.confirmPassword) }}
                    </div>
                {% endif %}

                {% if registrationForm.agreeTerms is defined %}
                    <div class="form-check mt-3">
                        {{ form_widget(registrationForm.agreeTerms, {
                            'attr': {
                                'class': 'form-check-input'
                            }
                        }) }}

                        {{ form_label(registrationForm.agreeTerms, null, {
                            'label_attr': {
                                'class': 'form-check-label'
                            }
                        }) }}

                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>
                {% endif %}

                <div class="d-grid">
                    <button type="submit" class="btn btn-outline-info btn-lg mt-3">
                        S'inscrire
                    </button>
                </div>

            {{ form_end(registrationForm) }}

            <div class="auth-divider">ou</div>

            <a href="#" class="btn-discord">
                <svg viewBox="0 0 24 24">
                    <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
                </svg>
                Continuer avec Discord
            </a>

            <div class="login-auth-link mt-3">
                <p>Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a></p>
            </div>

        </div>
    </div>
</div>

{% endblock %}
