{% extends 'base.html.twig' %}
{% import '_shared/_password_field.html.twig' as ui %}
{% import '_shared/_discord_button.html.twig' as discord %}

{% block title %}Créer un compte - LES-BATARK{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/register.css') }}">
{% endblock %}

{% block body %}

<div class="auth-frame">
    <div class="auth-bg" style="background-image: url('{{ asset('images/abe.jpg') }}')">
        <div class="auth-card border-dark">
           
            <div class="card-header text-center">
                <h1>Créer un compte</h1>
            </div>

            {{ form_start(registrationForm, {
                'attr': {
                    'class': 'register-form',
                    'data-turbo': 'false'
                }
            }) }}

                <div class="mb-3">
                    {{ form_label(registrationForm.pseudo) }}
                    {{ form_widget(registrationForm.pseudo, {
                        'attr': {
                            'class': 'pseudo form-control',
                            'placeholder': 'votre pseudo Discord'
                        }
                    }) }}
                    {{ form_errors(registrationForm.pseudo) }}
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.email) }}
                    {{ form_widget(registrationForm.email, {
                        'attr': {
                            'class': 'email form-control',
                            'placeholder': 'Entrez votre email'
                        }
                    }) }}
                    {{ form_errors(registrationForm.email) }}
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.plainPassword.first) }}
                    {% set password_input %}
                        {{ form_widget(registrationForm.plainPassword.first, {
                            'attr': {
                                'class': 'password form-control',
                                'placeholder': 'Créez un mot de passe'
                            }
                        }) }}
                    {% endset %}
                    {{ ui.field(password_input, registrationForm.plainPassword.first.vars.id) }}
                    {{ form_errors(registrationForm.plainPassword.first) }}
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.plainPassword.second) }}
                    {% set confirm_password_input %}
                        {{ form_widget(registrationForm.plainPassword.second, {
                            'attr': {
                                'class': 'password form-control',
                                'placeholder': 'Confirmez votre mot de passe'
                            }
                        }) }}
                    {% endset %}
                    {{ ui.field(confirm_password_input, registrationForm.plainPassword.second.vars.id) }}
                    {{ form_errors(registrationForm.plainPassword.second) }}
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-outline-info btn-lg mt-3">
                        S'inscrire
                    </button>
                </div>

            {{ form_end(registrationForm) }}

            <div class="auth-divider">ou</div>

            {{ discord.button("S'inscrire avec Discord", '#') }}

            <div class="login-register-link mt-3">
                <p>Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a></p>
            </div>

        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {% include '_shared/_password_toggle_script.html.twig' %}
{% endblock %}
