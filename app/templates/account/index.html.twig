{% extends 'base.html.twig' %}
{% import '_shared/_confirm_modal.html.twig' as modals %}

{% block title %}Mon compte — LES-BATARK{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/account.css') }}">
{% endblock %}

{% block body %}
<div class="auth-frame">
    <div class="auth-bg" style="background-image: url('{{ asset('images/abe.jpg') }}')">
        <div class="auth-card border-dark">

            <div class="card-header text-center">
                <h1 class="h1 fw-bold mb-1">Mon compte</h1>
            </div>

            {{ include('_shared/_flash.html.twig') }}

            <ul class="nav admin-tabs mb-4">
                <li class="nav-item">
                    <button type="button" class="btn btn-primary{{ activeTab == 'orders' ? ' active' : '' }}" data-bs-toggle="pill" data-bs-target="#orders">
                        Mes commandes
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="btn btn-primary{{ activeTab == 'password' ? ' active' : '' }}" data-bs-toggle="pill" data-bs-target="#password">
                        Modifier mon mot de passe
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="btn btn-primary{{ activeTab == 'pseudo' ? ' active' : '' }}" data-bs-toggle="pill" data-bs-target="#pseudo">
                        Modifier mon pseudo
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade{{ activeTab == 'orders' ? ' show active' : '' }}" id="orders">
                    {% include 'account/orders_tab.html.twig' %}
                </div>
                <div class="tab-pane fade{{ activeTab == 'password' ? ' show active' : '' }}" id="password">
                    {% include 'account/password_tab.html.twig' %}
                </div>
                <div class="tab-pane fade{{ activeTab == 'pseudo' ? ' show active' : '' }}" id="pseudo">
                    {% include 'account/pseudo_tab.html.twig' %}
                </div>
            </div>

            <div class="admin-section-title">
                <h2 class="h5 fw-semibold text-danger mt-5 mb-0">Zone Rouge</h2>
            </div>
            <div class="card border-danger">
                <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <p class="text-danger mb-0">La suppression de votre compte est définitive.</p>
                    <form method="post" action="{{ path('account_delete') }}" id="deleteAccountForm">
                        <input type="hidden" name="_token" value="{{ csrf_token('account_delete') }}">
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">Supprimer mon compte</button>
                    </form>
                </div>
            </div>

            {{ modals.modal('deleteAccountModal', 'Supprimer le compte', 'Supprimer définitivement votre compte ? Cette action est irréversible.', 'deleteAccountForm', 'Supprimer', 'danger') }}

        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {% include '_shared/_password_toggle_script.html.twig' %}
{% endblock %}
