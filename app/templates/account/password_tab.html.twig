{% import '_shared/_password_field.html.twig' as ui %}
{% import '_shared/_confirm_modal.html.twig' as modals %}

<div class="card border-primary">
    <div class="card-body p-4">
        <h2 class="h3 fw-semibold text-white mb-3">Modifier mon mot de passe</h2>

        <form method="post" action="{{ path('account_change_password') }}">
            <div class="mb-3">
                <label for="current_password">Mot de passe actuel</label>
                {% set current_password_input %}
                    <input class="password form-control" type="password" id="current_password" name="currentPassword"
                        autocomplete="current-password" required
                    >
                {% endset %}
                {{ ui.field(current_password_input, 'current_password') }}
                <div class="form-text mt-1">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#forgotCurrentPasswordModal">Mot de passe actuel oublié ?</a>
                </div>
            </div>

            <div class="mb-3">
                <label for="new_password">Nouveau mot de passe</label>
                {% set new_password_input %}
                    <input class="password form-control" type="password" id="new_password" name="newPassword"
                        autocomplete="new-password" required
                    >
                {% endset %}
                {{ ui.field(new_password_input, 'new_password') }}
            </div>

            <div class="mb-3">
                <label for="new_password_confirm">Confirmez le nouveau mot de passe</label>
                {% set new_password_confirm_input %}
                    <input class="password form-control" type="password" id="new_password_confirm" name="newPasswordConfirm"
                        autocomplete="new-password" required
                    >
                {% endset %}
                {{ ui.field(new_password_confirm_input, 'new_password_confirm') }}
            </div>

            <input type="hidden" name="_token" value="{{ csrf_token('account_change_password') }}">

            <hr class="border-secondary my-4">

            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-outline-info btn-lg">Mettre à jour le mot de passe</button>
            </div>
        </form>
    </div>
</div>

<form method="post" action="{{ path('account_forgot_password') }}" id="forgotCurrentPasswordForm">
    <input type="hidden" name="_token" value="{{ csrf_token('account_forgot_current_password') }}">
</form>
{{ modals.modal(
    'forgotCurrentPasswordModal',
    'Mot de passe actuel oublié ?',
    'Vous serez déconnecté et recevrez un lien par email pour définir un nouveau mot de passe.',
    'forgotCurrentPasswordForm',
    'Continuer',
    'info'
) }}
