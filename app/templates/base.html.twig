<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}ARK Community{% endblock %}</title>

        <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/vapor/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/register.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    </head>

    <body class="{% block body_class %}{% endblock %}">

        {# pour cacher la nav sur certaines pages avec {% set showNavbar = false %} #}
        {% if showNavbar is not defined or showNavbar %}
            {% include '_shared/_nav.html.twig' %}
        {% endif %}
       
        <main>
            {% block body %}{% endblock %}
        </main>
        
        {% include '_shared/_footer.html.twig' %}

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>