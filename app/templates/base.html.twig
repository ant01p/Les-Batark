<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}ARK Community{% endblock %}</title>

        <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/vapor/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/cards.css') }}">
        
        {% block stylesheets %}{% endblock %}
    </head>

    <body class="{% block body_class %}{% endblock %}">

        {% include '_shared/_nav.html.twig' %}
        
        <main>
            {% block body %}{% endblock %}
        </main>
        
        {% include '_shared/_footer.html.twig' %}

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {{ importmap('app') }}
        {% block javascripts %}{% endblock %}
    </body>
</html>