{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} — Les BATARK{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/product.css') }}">
{% endblock %}

{% block body_class %}events-page{% endblock %}

{% block body %}

<section class="bg" style="background-image: url('{{ asset('images/shop68.png') }}')">
    <div class="bg-overlay">
        <div class="container">

            <div class="row justify-content-center mb-4">
                <div class="col-lg-8">
                    <a href="{{ path('app_shop', { category: product.category.id }) }}" class="btn btn-outline-secondary btn-sm mt-4 fs-5">
                        Retour à la boutique
                    </a>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card border-secondary content-card">

                        {{ include('product/_image_carousel.html.twig', {
                            product: product,
                            wrapper_class: 'product-show-carousel',
                            img_class: 'product-show-img',
                        }) }}

                        <div class="card-body">
                            <div class="d-flex flex-column align-items-start gap-2 mb-2">
                                <span class="badge bg-secondary">{{ product.category.name }}</span>
                                <span class="card-title">{{ product.name }}</span>
                            </div>

                            {% if product.description %}
                                <p class="card-desc">{{ product.description }}</p>
                            {% endif %}

                            <p class="text-info fw-bold mb-4">{{ (product.price / 100)|number_format(2, ',', ' ') }} €</p>

                            <form method="post" action="{{ path('cart_add', { id: product.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                                {% if product.hasType %}
                                    <div class="mb-3">
                                        <label class="form-label">Type</label>
                                        <select name="type_id" class="form-select" required>
                                            <option value="">Choisir le type</option>
                                            {% for type in types %}
                                                <option value="{{ type.id }}">{{ type.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                {% endif %}

                                {% if product.hasQuality %}
                                    <div class="mb-3">
                                        <label class="form-label">Qualité</label>
                                        <select name="quality_id" class="form-select" required>
                                            <option value="">Choisir la qualité</option>
                                            {% for quality in qualities %}
                                                <option value="{{ quality.id }}">{{ quality.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                {% endif %}

                                {% if product.category.name == constant('App\\Entity\\Category::DINOSAURES_NAME') %}
                                    {% if product.sexeActif %}
                                        <div class="mb-3">
                                            <label class="form-label">Sexe</label>
                                            <select name="sex" class="form-select" required>
                                                <option value="">Choisir le sexe</option>
                                                <option value="Mâle">Mâle</option>
                                                <option value="Femelle">Femelle</option>
                                            </select>
                                        </div>
                                    {% endif %}

                                    {% if product.versionsDisponibles is not empty %}
                                        <div class="mb-3">
                                            <label class="form-label">Version</label>
                                            <select name="version" class="form-select" required>
                                                <option value="">Choisir la version</option>
                                                {% for v in product.versionsDisponibles %}
                                                    <option value="{{ v }}">{{ v }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    {% endif %}

                                    <div class="mb-3">
                                        <label class="form-label">Statistique</label>
                                        <select name="stat" class="form-select">
                                            <option value="">Choisir la statistique</option>
                                            {% for s in constant('App\\Entity\\Product::STATS') %}
                                                <option value="{{ s }}">{{ s }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Option</label>
                                        <select name="option" class="form-select">
                                            <option value="">Choisir une option</option>
                                            {% for o in constant('App\\Entity\\Product::OPTIONS') %}
                                                <option value="{{ o }}">{{ o }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Couleur</label>
                                        <input type="text" name="color" class="form-control" placeholder="Ex : Bleu / Violet ou 0-14 / 1-28">
                                    </div>
                                {% endif %}

                                <div class="mb-3">
                                    <label class="form-label">Quantité</label>
                                    <input type="number" name="quantity" value="1" min="1" class="form-control" style="max-width: 120px;">
                                </div>

                                <button type="submit" class="btn btn-outline-success btn-lg w-100">
                                    Ajouter au panier
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

{% endblock %}