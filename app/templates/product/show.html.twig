{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} — Les BATARK{% endblock %}

{% block body_class %}events-page{% endblock %}

{% block body %}

<section class="events-bg" style="background-image: url('{{ asset('images/shop.png') }}')">
    <div class="events-bg-overlay">
        <div class="container">

            <div class="row justify-content-center mb-4">
                <div class="col-lg-8">
                    <a href="{{ path('app_shop', { category: product.category.id }) }}" class="btn btn-outline-secondary btn-sm">
                        Retour à la boutique
                    </a>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card border-secondary event-card">
                        {#{% if product.imageUrl %}
                            <img src="{{ product.imageUrl }}" alt="{{ product.name }}" class="card-img-top">
                        {% endif %}#}

                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-secondary">{{ product.category.name }}</span>
                                <span class="event-card-title">{{ product.name }}</span>
                            </div>

                            {% if product.description %}
                                <p class="event-card-desc">{{ product.description }}</p>
                            {% endif %}

                            <p class="text-info fw-bold mb-4">{{ (product.price / 100)|number_format(2, ',', ' ') }} €</p>

                            <form method="post" action="{{ path('cart_add', { id: product.id }) }}">
                                {% if product.hasType %}
                                    <div class="mb-3">
                                        <label class="form-label">Type</label>
                                        <select name="type_id" class="form-select" required>
                                            <option value="">Choisir le type</option>
                                            {% for type in types %}
                                                <option value="{{ type.id }}">{{ type.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                {% endif %}

                                {% if product.hasQuality %}
                                    <div class="mb-3">
                                        <label class="form-label">Qualité</label>
                                        <select name="quality_id" class="form-select" required>
                                            <option value="">Choisir la qualité</option>
                                            {% for quality in qualities %}
                                                <option value="{{ quality.id }}">{{ quality.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                {% endif %}

                                <div class="mb-3">
                                    <label class="form-label">Quantité</label>
                                    <input type="number" name="quantity" value="1" min="1" class="form-control" style="max-width: 120px;">
                                </div>

                                <button type="submit" class="btn btn-outline-success btn-lg w-100">
                                    Ajouter au panier
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

{% endblock %}