{% import '_shared/_confirm_modal.html.twig' as modals %}

<div class="admin-section-title">
    <h2 class="h2 fw-semibold text-white mb-0">Événements</h2>
</div>
<a href="{{ path('admin_event_new') }}" class="btn btn-success mb-3">Ajouter</a>

{% if events is empty %}
    <div class="card border-secondary">
        <div class="card-body text-center text-muted py-5">
            Aucun événement pour l'instant.
        </div>
    </div>
{% else %}
    <div class="row g-3">
        {% for event in events %}
            {% set borderClass = event.status == 'ongoing' ? 'border-success' : (event.status == 'upcoming' ? 'border-warning' : 'border-secondary') %}
            <div class="col-md-6">
                <div class="card content-card admin-event-card {{ borderClass }} h-100">
                    {% include 'event/_card.html.twig' with {event: event, showDescription: false} %}

                    <div class="admin-actions">
                        <a href="{{ path('admin_event_edit', {id: event.id}) }}" class="btn btn-primary">Modifier</a>
                        <form method="post" action="{{ path('admin_event_delete', {id: event.id}) }}" id="deleteEventForm{{ event.id }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteEventModal{{ event.id }}">Supprimer</button>
                        </form>
                    </div>
                </div>
            </div>
            {{ modals.modal('deleteEventModal' ~ event.id, "Supprimer l'événement", 'Supprimer cet événement ?', 'deleteEventForm' ~ event.id, 'Supprimer', 'danger') }}
        {% endfor %}
    </div>
{% endif %}
