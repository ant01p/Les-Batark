{% import '_shared/_confirm_modal.html.twig' as modals %}

<div class="mb-3" data-controller="category-picker">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <a href="{{ path('admin_category_new') }}" class="btn btn-success text-dark">Ajouter une catégorie</a>
        {% if categories is not empty %}
            <button type="button" class="btn btn-warning btn-sm text-dark" data-category-picker-target="editButton" data-action="click->category-picker#toggleEdit">
                Modifier une catégorie
            </button>
            <button type="button" class="btn btn-danger btn-sm text-dark" data-category-picker-target="deleteButton" data-action="click->category-picker#toggleDelete">
                Supprimer une catégorie
            </button>
            <span class="small text-muted" data-category-picker-target="hint"></span>
        {% endif %}
    </div>

    {% if categories is not empty %}
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('admin_product_index') }}"
               class="btn btn-primary admin-category-btn d-flex align-items-center justify-content-center{{ activeCategory is null ? ' active' : '' }}">
                Toutes
            </a>
            {% for category in categories %}
                <a href="{{ path('admin_product_index', { category: category.id }) }}"
                   class="btn btn-primary admin-category-btn{{ activeCategory and category.id == activeCategory.id ? ' active' : '' }}"
                   data-category-picker-target="category"
                   data-action="click->category-picker#pick"
                   data-edit-url="{{ path('admin_category_edit', {id: category.id}) }}"
                   data-delete-modal="deleteCategoryModal{{ category.id }}">
                    {{ category.name }}
                </a>
                <form id="delete-category-{{ category.id }}" method="post" action="{{ path('admin_category_delete', {id: category.id}) }}" class="d-none">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}">
                </form>
                {{ modals.modal('deleteCategoryModal' ~ category.id, 'Supprimer la catégorie', 'Supprimer cette catégorie ? Tous les produits associés seront également supprimés définitivement.', 'delete-category-' ~ category.id, 'Supprimer', 'danger') }}
            {% endfor %}
        </div>
    {% endif %}
</div>

<div class="mb-3 d-flex gap-2">
    <a href="{{ path('admin_product_new') }}" class="btn btn-success text-dark">Ajouter un produit</a>
   
</div>

{% if products is empty %}

    <div class="card border-secondary">
        <div class="card-body text-center text-muted py-5">
            Aucun article pour l'instant.
        </div>
    </div>

{% else %}

    <div class="row g-3">
        {% for product in products %}
            <div class="col-6 col-md-4 col-lg-3">

                <div class="card border-primary h-100 admin-product-card">
                    <div class="card-body d-flex flex-column">

                        {% set mainImage = product.mainImage %}
                        {% if mainImage %}
                            <img src="{{ asset('uploads/imageProduct/' ~ mainImage.filename) }}" alt="" class="admin-product-thumb mb-2">
                        {% endif %}

                        <span class="badge bg-secondary align-self-start mb-2">{{ product.category.name }}</span>

                        <div class="d-flex flex-column align-items-start gap-1 flex-md-row justify-content-md-between align-items-md-center mb-2">
                            <h3 class="h6 fw-semibold text-white mb-0">{{ product.name }}</h3>
                            <span class="admin-product-price">{{ (product.price / 100)|number_format(2) }} €</span>
                        </div>

                        {% if product.description %}
                            <p class="text-muted mb-3">{{ product.description }}</p>
                        {% endif %}

                        <div class="admin-actions mt-auto d-flex align-items-center justify-content-between">

                            <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="btn btn-primary" title="Modifier" aria-label="Modifier"><i class="bi bi-pencil-fill"></i></a>

                            <form method="post" action="{{ path('admin_product_delete', {id: product.id}) }}" class="m-0" id="deleteProductForm{{ product.id }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">

                                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteProductModal{{ product.id }}" title="Supprimer" aria-label="Supprimer"><i class="bi bi-trash-fill"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
                {{ modals.modal('deleteProductModal' ~ product.id, 'Supprimer le produit', 'Supprimer ce produit ?', 'deleteProductForm' ~ product.id, 'Supprimer', 'danger') }}
            </div>
        {% endfor %}
    </div>
{% endif %}