<div class="admin-section-title mb-3">
    <h2 class="h5 fw-semibold text-white mb-0">Boutique</h2>
</div>

{% if categories is not empty %}
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a href="{{ path('admin_index', { tab: 'shop' }) }}"
           class="btn btn-primary{{ activeCategory is null ? ' active' : '' }}">
            Toutes
        </a>
        {% for category in categories %}
            <a href="{{ path('admin_index', { tab: 'shop', category: category.id }) }}"
               class="btn btn-primary{{ activeCategory and category.id == activeCategory.id ? ' active' : '' }}">
                {{ category.name }}
            </a>
        {% endfor %}
    </div>
{% endif %}

<div class="mb-3">
    <a href="{{ path('admin_product_new') }}" class="btn btn-success text-dark">Ajouter un produit</a>
</div>

{% if products is empty %}

    <div class="card border-secondary">
        <div class="card-body text-center text-muted py-5">
            Aucun article pour l'instant.
        </div>
    </div>

{% else %}

    <div class="row g-3">
        {% for product in products %}
            <div class="col-md-6 col-lg-4">

                <div class="card border-primary h-100">
                    <div class="card-body d-flex flex-column">

                        {% set mainImage = product.mainImage %}
                        {% if mainImage %}
                            <img src="{{ asset('uploads/imageProduct/' ~ mainImage.filename) }}" alt="" class="admin-product-thumb mb-2">
                        {% endif %}

                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h6 fw-semibold text-white mb-0">{{ product.name }}</h3>
                            <span class="badge bg-success">{{ (product.price / 100)|number_format(2) }} €</span>
                        </div>

                        <span class="badge bg-secondary align-self-start mb-2">{{ product.category.name }}</span>

                        {% if product.description %}
                            <p class="text-muted small mb-3">{{ product.description }}</p>
                        {% endif %}

                        <div class="mt-auto d-flex gap-2">

                            <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="btn btn-sm btn-primary flex-fill">Modifier</a>

                            <form method="post" action="{{ path('admin_product_delete', {id: product.id}) }}"
                                onsubmit="return confirm('Supprimer ce produit ?')" class="flex-fill">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">

                                <button type="submit" class="btn btn-sm btn-danger w-100">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}