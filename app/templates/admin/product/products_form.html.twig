{% extends 'base.html.twig' %}

{% block title %}
    {% if product.id is null %}
        Créer un produit
    {% else %}
        Modifier le produit
    {% endif %}
     — Les BATARK
{% endblock %}

{% block body_class %}admin-body{% endblock %}
{% block body_style %} style="--admin-bg-image: url('{{ asset('images/abe.jpg') }}')"{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}

{% block body %}
<div class="admin-page">

    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <div class="d-flex align-items-center gap-3">
                <a href="{{ path('admin_product_index') }}" class="btn btn-outline-secondary btn-sm">
                    Retour
                </a>
                <div>
                    <h1 class="h3 fw-bold text-white mb-0">
                        {% if product.id is null %}
                            Nouveau produit
                        {% else %}
                            Modifier : {{ product.name }}
                        {% endif %}
                    </h1>
                    <p class="text-muted mb-0 small">Panneau d'administration</p>
                </div>
            </div>
        </div>
    </div>

    {{ include('_shared/_flash.html.twig') }}

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-primary">
                <div class="card-body p-4">

                    {{ form_start(form) }}

                    {# category #}
                    <div class="mb-3">
                        {{ form_label(form.category) }}
                        <div class="d-flex flex-wrap gap-2" id="category-capsules">
                            {% for child in form.category %}
                                {{ form_widget(child, {attr: {class: 'btn-check', 'data-category-name': child.vars.label}}) }}
                                <label class="btn btn-outline-primary" for="{{ child.vars.id }}">{{ child.vars.label }}</label>
                            {% endfor %}
                        </div>
                        {{ form_errors(form.category) }}
                    </div>

                    {# Nom #}
                    <div class="mb-3">
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name, {attr: {class: 'form-control', placeholder: 'Ex : Boost XP x2'}}) }}
                        {{ form_errors(form.name) }}
                    </div>

                    {# Champs spécifiques Dinosaures #}
                    <div id="dino-fields" class="d-none">
                        <hr class="border-secondary my-4">
                        <h5 class="text-white">Configuration Dinosaure</h5>

                        <div class="mb-3">
                            {{ form_label(form.versionsDisponibles) }}
                            <div class="d-flex flex-wrap gap-3">
                                {% for child in form.versionsDisponibles %}
                                    <div class="form-check">
                                        {{ form_widget(child, {attr: {class: 'form-check-input'}}) }}
                                        {{ form_label(child, null, {label_attr: {class: 'form-check-label'}}) }}
                                    </div>
                                {% endfor %}
                            </div>
                            {{ form_errors(form.versionsDisponibles) }}
                        </div>

                        <div class="mb-3 form-check">
                            {{ form_widget(form.sexeActif, {attr: {class: 'form-check-input'}}) }}
                            {{ form_label(form.sexeActif) }}
                            {{ form_errors(form.sexeActif) }}
                        </div>

                        <hr class="border-secondary my-4">
                    </div>

                    {# Prix #}
                    <div class="mb-3">
                        {{ form_label(form.price) }}
                        {{ form_widget(form.price, {attr: {class: 'form-control', placeholder: 'Ex : 100'}}) }}
                        {{ form_errors(form.price) }}
                    </div>

                    {# Description #}
                    <div class="mb-3">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description, {attr: {class: 'form-control', placeholder: 'Décrivez le produit…'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    {# Type / Qualité (non pertinents pour un produit Dinosaures) #}
                    <div id="type-quality-fields">
                        {# hasType #}
                        <div class="mb-3 form-check">
                            {{ form_widget(form.hasType, {attr: {class: 'form-check-input'}}) }}
                            {{ form_label(form.hasType) }}
                            {{ form_errors(form.hasType) }}
                        </div>

                        {# hasQuality #}
                        <div class="mb-3 form-check">
                            {{ form_widget(form.hasQuality, {attr: {class: 'form-check-input'}}) }}
                            {{ form_label(form.hasQuality) }}
                            {{ form_errors(form.hasQuality) }}
                        </div>
                    </div>

                    <hr class="border-secondary my-4">

                    {# Photos #}
                    <div class="mb-3">
                        <label class="form-label">Photos</label>

                        {% if product.images is defined and product.images|length > 0 %}
                            <div class="row g-2 mb-3" id="existing-images">
                                {% for image in product.images %}
                                    <div class="col-6 col-md-4 image-row" data-image-id="{{ image.id }}">
                                        <div class="image-row-inner">
                                            <img src="{{ asset('uploads/imageProduct/' ~ image.filename) }}" alt="" class="image-thumb">

                                            <div class="form-check mt-2">
                                                <input type="radio" name="mainImage" value="existing_{{ image.id }}"
                                                    class="form-check-input main-image-radio"
                                                    id="main-existing-{{ image.id }}"
                                                    {{ image.isMain ? 'checked' : '' }}>
                                                <label class="form-check-label small" for="main-existing-{{ image.id }}">Image principale</label>
                                            </div>

                                            <input type="checkbox" name="deleteImages[]" value="{{ image.id }}" class="d-none delete-image-checkbox">
                                            <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-1 delete-image-btn">Supprimer</button>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="row g-2" id="image-collection"
                            data-prototype="{{ form_widget(form.images.vars.prototype)|e('html_attr') }}"
                            data-index="0"></div>

                        <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="add-image-btn">+ Ajouter une photo</button>
                        {{ form_errors(form.images) }}
                    </div>

                    <hr class="border-secondary my-4">

                    <div class="d-grid">
                        <button type="submit" class="btn btn-outline-success btn-lg mt-3">
                            {% if product.id is null %}
                                Créer le produit
                            {% else %}
                                Enregistrer
                            {% endif %}
                        </button>
                    </div>

                    {{ form_end(form) }}

                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const dinoFields = document.getElementById('dino-fields');
            const typeQualityFields = document.getElementById('type-quality-fields');
            const categoryRadios = document.querySelectorAll('#category-capsules input[type="radio"]');
            const DINO_NAME = '{{ constant('App\\Entity\\Category::DINOSAURES_NAME') }}';

            function resetDinoField(el) {
                if (el.type === 'checkbox' || el.type === 'radio') {
                    el.checked = false;
                } else {
                    el.value = '';
                }
            }

            function updateDinoFields() {
                const checked = document.querySelector('#category-capsules input[type="radio"]:checked');
                const isDino = checked && checked.dataset.categoryName.trim() === DINO_NAME;

                if (dinoFields) {
                    dinoFields.classList.toggle('d-none', !isDino);
                }
                if (typeQualityFields) {
                    typeQualityFields.classList.toggle('d-none', isDino);
                }

                if (!isDino) {
                    document.querySelectorAll('#dino-fields input, #dino-fields select').forEach(resetDinoField);
                } else {
                    document.querySelectorAll('#type-quality-fields input').forEach(resetDinoField);
                }
            }

            categoryRadios.forEach(function (radio) {
                radio.addEventListener('change', updateDinoFields);
            });
            updateDinoFields();

            const collection = document.getElementById('image-collection');
            const addButton = document.getElementById('add-image-btn');

            function buildPreview() {
                const preview = document.createElement('img');
                preview.className = 'image-thumb image-preview d-none';
                preview.alt = '';
                return preview;
            }

            function wireFileInput(fileInput, preview) {
                fileInput.classList.add('form-control', 'image-file-input');
                fileInput.addEventListener('change', function () {
                    const file = fileInput.files[0];
                    if (!file) {
                        preview.classList.add('d-none');
                        preview.removeAttribute('src');
                        return;
                    }
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        preview.src = event.target.result;
                        preview.classList.remove('d-none');
                    };
                    reader.readAsDataURL(file);
                });
            }

            if (addButton && collection) {
                addButton.addEventListener('click', function () {
                    const index = parseInt(collection.dataset.index, 10);
                    const html = collection.dataset.prototype.replace(/__image_name__/g, index);

                    const wrapper = document.createElement('div');
                    wrapper.innerHTML = html;
                    const fileInput = wrapper.querySelector('input[type="file"]');

                    const row = document.createElement('div');
                    row.className = 'col-6 col-md-4 image-row new-image-row';

                    const inner = document.createElement('div');
                    inner.className = 'image-row-inner';

                    const preview = buildPreview();
                    wireFileInput(fileInput, preview);

                    const radioWrap = document.createElement('div');
                    radioWrap.className = 'form-check mt-2';
                    radioWrap.innerHTML =
                        '<input type="radio" name="mainImage" value="new_' + index + '" class="form-check-input main-image-radio" id="main-new-' + index + '">' +
                        '<label class="form-check-label small" for="main-new-' + index + '">Image principale</label>';

                    const removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.className = 'btn btn-sm btn-outline-danger w-100 mt-1';
                    removeBtn.textContent = 'Supprimer';
                    removeBtn.addEventListener('click', function () {
                        row.remove();
                    });

                    inner.appendChild(preview);
                    inner.appendChild(fileInput);
                    inner.appendChild(radioWrap);
                    inner.appendChild(removeBtn);
                    row.appendChild(inner);
                    collection.appendChild(row);

                    collection.dataset.index = index + 1;
                });
            }

            document.querySelectorAll('.delete-image-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    const row = button.closest('.image-row');
                    const checkbox = row.querySelector('.delete-image-checkbox');
                    const radio = row.querySelector('.main-image-radio');
                    const marked = row.classList.toggle('marked-for-deletion');

                    checkbox.checked = marked;
                    radio.disabled = marked;
                    if (marked) {
                        radio.checked = false;
                    }
                    button.textContent = marked ? 'Annuler' : 'Supprimer';
                });
            });
        })();
    </script>
{% endblock %}