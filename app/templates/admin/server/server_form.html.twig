{% extends 'base.html.twig' %}

{% block title %}
    {% if server.id is null %}
        Créer un serveur
    {% else %}
        Modifier le serveur
    {% endif %}
     — Les BATARK
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}

{% block body %}
<div class="admin-page">

    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <div class="d-flex align-items-center gap-3">
                <a href="{{ path('admin_server_index') }}" class="btn btn-outline-secondary btn-sm">
                    Retour
                </a>
                <div>
                    <h1 class="h3 fw-bold text-white mb-0">
                        {% if server.id is null %}
                            Nouveau serveur
                        {% else %}
                            Modifier : {{ server.title }}
                        {% endif %}
                    </h1>
                    <p class="text-muted mb-0 small">Panneau d'administration</p>
                </div>
            </div>
        </div>
    </div>

    {{ include('_shared/_flash.html.twig') }}

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-primary">
                <div class="card-body p-4">

                    {{ form_start(form) }}

                    <p class="fw-semibold text-white mb-3">Informations principales</p>

                    <div class="mb-3">
                        {{ form_label(form.title) }}
                        {{ form_widget(form.title, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.gameMode) }}
                        <div class="d-flex gap-3">
                            {% for choice in form.gameMode %}
                                <div class="form-check form-check-inline">
                                    {{ form_widget(choice, {attr: {class: 'form-check-input'}}) }}
                                    {{ form_label(choice, null, {label_attr: {class: 'form-check-label'}}) }}
                                </div>
                            {% endfor %}
                        </div>
                        {{ form_errors(form.gameMode) }}
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            {{ form_label(form.maxPlayers) }}
                            {{ form_widget(form.maxPlayers, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.maxPlayers) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.address) }}
                            {{ form_widget(form.address, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.address) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.mods) }}
                        {{ form_widget(form.mods, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.mods) }}
                    </div>

                    {# Photos #}
                    <div class="mb-3">
                        <label class="form-label">Photos</label>

                        {% if server.images is defined and server.images|length > 0 %}
                            <div class="row g-2 mb-3" id="existing-images">
                                {% for image in server.images %}
                                    <div class="col-6 col-md-4 image-row" data-image-id="{{ image.id }}">
                                        <div class="image-row-inner">
                                            <img src="{{ asset('uploads/imageServer/' ~ image.filename) }}" alt="" class="image-thumb">

                                            <div class="form-check mt-2">
                                                <input type="radio" name="mainImage" value="existing_{{ image.id }}"
                                                    class="form-check-input main-image-radio"
                                                    id="main-existing-{{ image.id }}"
                                                    {{ image.isMain ? 'checked' : '' }}>
                                                <label class="form-check-label small" for="main-existing-{{ image.id }}">Image principale</label>
                                            </div>

                                            <input type="checkbox" name="deleteImages[]" value="{{ image.id }}" class="d-none delete-image-checkbox">
                                            <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-1 delete-image-btn">Supprimer</button>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="row g-2" id="image-collection"
                            data-prototype="{{ form_widget(form.images.vars.prototype)|e('html_attr') }}"
                            data-index="0"></div>

                        <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="add-image-btn">+ Ajouter une photo</button>
                        {{ form_errors(form.images) }}
                    </div>

                    <hr class="border-secondary my-4">
                    <p class="fw-semibold text-white mb-3">Paramètres du serveur</p>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            {{ form_label(form.harvestRate) }}
                            {{ form_widget(form.harvestRate, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.harvestRate) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.tamingSpeed) }}
                            {{ form_widget(form.tamingSpeed, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.tamingSpeed) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.matingInterval) }}
                            {{ form_widget(form.matingInterval, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.matingInterval) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.maturationSpeed) }}
                            {{ form_widget(form.maturationSpeed, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.maturationSpeed) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.incubationSpeed) }}
                            {{ form_widget(form.incubationSpeed, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.incubationSpeed) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.itemStackSize) }}
                            {{ form_widget(form.itemStackSize, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.itemStackSize) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.wildDinoFoodDrain) }}
                            {{ form_widget(form.wildDinoFoodDrain, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.wildDinoFoodDrain) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.maxDinoLevel) }}
                            {{ form_widget(form.maxDinoLevel, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.maxDinoLevel) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.maxTekDinoLevel) }}
                            {{ form_widget(form.maxTekDinoLevel, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.maxTekDinoLevel) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.maxEggLevel) }}
                            {{ form_widget(form.maxEggLevel, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.maxEggLevel) }}
                        </div>
                    </div>

                    <hr class="border-secondary my-4">

                    <div class="d-grid">
                        <button type="submit" class="btn btn-outline-success btn-lg mt-3">
                            {% if server.id is null %}
                                Créer le serveur
                            {% else %}
                                Enregistrer
                            {% endif %}
                        </button>
                    </div>

                    {{ form_end(form) }}

                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const collection = document.getElementById('image-collection');
            const addButton = document.getElementById('add-image-btn');

            function buildPreview() {
                const preview = document.createElement('img');
                preview.className = 'image-thumb image-preview d-none';
                preview.alt = '';
                return preview;
            }

            function wireFileInput(fileInput, preview) {
                fileInput.classList.add('form-control', 'image-file-input');
                fileInput.addEventListener('change', function () {
                    const file = fileInput.files[0];
                    if (!file) {
                        preview.classList.add('d-none');
                        preview.removeAttribute('src');
                        return;
                    }
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        preview.src = event.target.result;
                        preview.classList.remove('d-none');
                    };
                    reader.readAsDataURL(file);
                });
            }

            if (addButton && collection) {
                addButton.addEventListener('click', function () {
                    const index = parseInt(collection.dataset.index, 10);
                    const html = collection.dataset.prototype.replace(/__image_name__/g, index);

                    const wrapper = document.createElement('div');
                    wrapper.innerHTML = html;
                    const fileInput = wrapper.querySelector('input[type="file"]');

                    const row = document.createElement('div');
                    row.className = 'col-6 col-md-4 image-row new-image-row';

                    const inner = document.createElement('div');
                    inner.className = 'image-row-inner';

                    const preview = buildPreview();
                    wireFileInput(fileInput, preview);

                    const radioWrap = document.createElement('div');
                    radioWrap.className = 'form-check mt-2';
                    radioWrap.innerHTML =
                        '<input type="radio" name="mainImage" value="new_' + index + '" class="form-check-input main-image-radio" id="main-new-' + index + '">' +
                        '<label class="form-check-label small" for="main-new-' + index + '">Image principale</label>';

                    const removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.className = 'btn btn-sm btn-outline-danger w-100 mt-1';
                    removeBtn.textContent = 'Supprimer';
                    removeBtn.addEventListener('click', function () {
                        row.remove();
                    });

                    inner.appendChild(preview);
                    inner.appendChild(fileInput);
                    inner.appendChild(radioWrap);
                    inner.appendChild(removeBtn);
                    row.appendChild(inner);
                    collection.appendChild(row);

                    collection.dataset.index = index + 1;
                });
            }

            document.querySelectorAll('.delete-image-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    const row = button.closest('.image-row');
                    const checkbox = row.querySelector('.delete-image-checkbox');
                    const radio = row.querySelector('.main-image-radio');
                    const marked = row.classList.toggle('marked-for-deletion');

                    checkbox.checked = marked;
                    radio.disabled = marked;
                    if (marked) {
                        radio.checked = false;
                    }
                    button.textContent = marked ? 'Annuler' : 'Supprimer';
                });
            });
        })();
    </script>
{% endblock %}
