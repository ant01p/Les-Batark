{% extends 'admin/_layout.html.twig' %}

{% block admin_title %}Tableau de bord{% endblock %}

{% block admin_subtitle %}
    <p class="text-muted mb-0">Gérez les contenus du site LES-BATARK</p>
{% endblock %}

{% block admin_content %}

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card border-primary h-100">
                <div class="card-body text-center">
                    <i class="bi bi-people fs-2 text-primary d-block mb-2"></i>
                    <div class="h4 fw-bold text-white mb-0">{{ playerCount }}</div>
                    <div class="text-muted small">Joueurs inscrits</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-primary h-100">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-event fs-2 text-primary d-block mb-2"></i>
                    <div class="h4 fw-bold text-white mb-0">{{ eventCount }}</div>
                    <div class="text-muted small">Événements</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-primary h-100">
                <div class="card-body text-center">
                    <i class="bi bi-bag-check fs-2 text-primary d-block mb-2"></i>
                    <div class="h4 fw-bold text-white mb-0">{{ pendingOrderCount }}</div>
                    <div class="text-muted small">Commandes non livrées</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-primary h-100">
                <div class="card-body text-center">
                    <i class="bi bi-cash-stack fs-2 text-primary d-block mb-2"></i>
                    <div class="h4 fw-bold text-white mb-0">{{ (orderRevenue / 100)|number_format(2, ',', ' ') }} €</div>
                    <div class="text-muted small">Ventes boutique</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card border-secondary h-100">
                <div class="card-body">
                    <h2 class="h6 fw-semibold text-white mb-3">Activité récente</h2>
                    {% if recentActivity is empty %}
                        <p class="text-muted small mb-0">Aucune activité récente.</p>
                    {% else %}
                        <ul class="list-unstyled admin-activity-list mb-0">
                            {% for activity in recentActivity %}
                                <li class="d-flex align-items-start gap-2">
                                    <i class="bi {{ activity.icon }} text-primary"></i>
                                    <div class="flex-grow-1">
                                        {% if activity.link %}
                                            <a href="{{ path(activity.link) }}" class="text-white text-decoration-none">{{ activity.label }}</a>
                                        {% else %}
                                            <span class="text-white">{{ activity.label }}</span>
                                        {% endif %}
                                        <div class="text-muted small">{{ activity.date|date('d/m/Y à H:i') }}</div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-secondary h-100">
                <div class="card-body">
                    <h2 class="h6 fw-semibold text-white mb-3">Commandes en cours</h2>
                    {% if pendingOrders is empty %}
                        <p class="text-muted small mb-0">Aucune commande en attente.</p>
                    {% else %}
                        <ul class="list-unstyled admin-pending-orders-list mb-0">
                            {% for order in pendingOrders %}
                                <li>
                                    <a href="{{ path('admin_order_index') }}" class="d-flex justify-content-between text-decoration-none">
                                        <span class="text-white">#{{ order.orderCode }} — {{ order.customerPseudo }}</span>
                                        <span class="text-muted">{{ (order.total / 100)|number_format(2, ',', ' ') }} €</span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

{% endblock %}
