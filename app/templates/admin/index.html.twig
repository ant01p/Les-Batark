{% extends 'base.html.twig' %}

{% block title %}Admin — LES-BATARK{% endblock %}

{% block body %}
<div class="admin-page">

    <header class="mb-4">
        <h1 class="h3 fw-bold text-white mb-1">Panneau d'administration</h1>
        <p class="text-muted mb-0">Gérez les contenus du site LES-BATARK</p>
    </header>

    <ul class="nav admin-tabs mb-4">
        <li class="nav-item">
            <button type="button" class="btn btn-primary active" data-bs-toggle="pill" data-bs-target="#events">
                Événements
            </button>
        </li>

        <li class="nav-item">
            <button type="button" class="btn btn-primary" data-bs-toggle="pill" data-bs-target="#shop">
                Boutique
            </button>
        </li>

        <li class="nav-item">
            <button type="button" class="btn btn-primary" data-bs-toggle="pill" data-bs-target="#servers">
                Serveurs
            </button>
        </li>

        <li class="nav-item">
            <button type="button" class="btn btn-primary" data-bs-toggle="pill" data-bs-target="#rules">
                Règlement
            </button>
        </li>
    </ul>

    <hr class="border-secondary mb-4">

    <div class="tab-content">

        <div class="tab-pane fade show active" id="events">

            <div class="admin-section-title">
                <h2 class="h5 fw-semibold text-white mb-0">Événements</h2>
                <button type="button" class="btn btn-success">Ajouter</button>
            </div>

            <div class="card border-primary mb-3">
                <div class="card-body admin-card-body">
                    <div class="admin-card-content">
                        <span class="badge bg-warning me-2">À venir</span>
                        <span class="fw-semibold text-white">Chasse au Trésor Légendaire</span>

                        <p class="text-muted small mb-0 mt-1">
                            2026-06-20 à 20:00 — The Island - Zone Nord
                        </p>
                    </div>

                    <div class="admin-actions">
                        <button type="button" class="btn btn-primary">Modifier</button>
                        <button type="button" class="btn btn-danger">Supprimer</button>
                    </div>
                </div>
            </div>

            <div class="card border-primary mb-3">
                <div class="card-body admin-card-body">
                    <div class="admin-card-content">
                        <span class="badge bg-success text-dark me-2">En cours</span>
                        <span class="fw-semibold text-white">Tournoi PVP - Arène de Combat</span>

                        <p class="text-muted small mb-0 mt-1">
                            2026-06-15 à 19:00 — Arène Centrale
                        </p>
                    </div>

                    <div class="admin-actions">
                        <button type="button" class="btn btn-primary">Modifier</button>
                        <button type="button" class="btn btn-danger">Supprimer</button>
                    </div>
                </div>
            </div>

            <div class="card border-primary mb-3">
                <div class="card-body admin-card-body">
                    <div class="admin-card-content">
                        <span class="badge bg-secondary me-2">Terminé</span>
                        <span class="fw-semibold text-white">Construction Communautaire</span>

                        <p class="text-muted small mb-0 mt-1">
                            2026-05-20 à 18:00 — The Center - Zone Verte
                        </p>
                    </div>

                    <div class="admin-actions">
                        <button type="button" class="btn btn-primary">Modifier</button>
                        <button type="button" class="btn btn-danger">Supprimer</button>
                    </div>
                </div>
            </div>

        </div>

        <div class="tab-pane fade" id="shop">

            <div class="admin-section-title">
                <h2 class="h5 fw-semibold text-white mb-0">Boutique</h2>
                <button type="button" class="btn btn-success">Ajouter</button>
            </div>

            <div class="card border-secondary">
                <div class="card-body text-center text-muted py-5">
                    Aucun article pour l'instant.
                </div>
            </div>

        </div>

        <div class="tab-pane fade" id="servers">

            <div class="admin-section-title">
                <h2 class="h5 fw-semibold text-white mb-0">Serveurs</h2>
                <button type="button" class="btn btn-success">Ajouter</button>
            </div>

            <div class="card border-secondary">
                <div class="card-body text-center text-muted py-5">
                    Aucun serveur configuré.
                </div>
            </div>

        </div>

        <div class="tab-pane fade" id="rules">

            <div class="admin-section-title">
                <h2 class="h5 fw-semibold text-white mb-0">Règlement</h2>
                <button type="button" class="btn btn-success">Ajouter</button>
            </div>

            <div class="card border-secondary">
                <div class="card-body text-center text-muted py-5">
                    Aucune règle définie.
                </div>
            </div>

        </div>

    </div>
</div>
{% endblock %}