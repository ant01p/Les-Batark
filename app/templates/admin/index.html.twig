{% extends 'base.html.twig' %}

{% block title %}Admin — LES-BATARK{% endblock %}

{% block body %}
<div class="admin-page">

    <header class="mb-4">
        <h1 class="h3 fw-bold text-white mb-1">Panneau d'administration</h1>
        <p class="text-muted mb-0">Gérez les contenus du site LES-BATARK</p>
    </header>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show text-bold">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <ul class="nav admin-tabs mb-4">
        <li class="nav-item">
            <button type="button" class="btn btn-primary{{ activeTab == 'events' ? ' active' : '' }}" data-bs-toggle="pill" data-bs-target="#events">
                Événements
            </button>
        </li>

        <li class="nav-item">
            <button type="button" class="btn btn-primary{{ activeTab == 'shop' ? ' active' : '' }}" data-bs-toggle="pill" data-bs-target="#shop">
                Boutique
            </button>
        </li>

        <li class="nav-item">
            <button type="button" class="btn btn-primary" data-bs-toggle="pill" data-bs-target="#servers">
                Serveurs
            </button>
        </li>

        <li class="nav-item">
            <button type="button" class="btn btn-primary" data-bs-toggle="pill" data-bs-target="#rules">
                Règlement
            </button>
        </li>
    </ul>

    <hr class="border-secondary mb-4">

    <div class="tab-content">

        <div class="tab-pane fade{{ activeTab == 'events' ? ' show active' : '' }}" id="events">
            {% include 'admin/event/events_tab.html.twig' %}
        </div>

        <div class="tab-pane fade{{ activeTab == 'shop' ? ' show active' : '' }}" id="shop">
            {% include 'admin/product/products_tab.html.twig' %}
        </div>

        <div class="tab-pane fade" id="servers">
            <div class="admin-section-title">
                <h2 class="h5 fw-semibold text-white mb-0">Serveurs</h2>
                <button type="button" class="btn btn-success">Ajouter</button>
            </div>
            <div class="card border-secondary">
                <div class="card-body text-center text-muted py-5">
                    Aucun serveur configuré.
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="rules">
            <div class="admin-section-title">
                <h2 class="h5 fw-semibold text-white mb-0">Règlement</h2>
                <button type="button" class="btn btn-success">Ajouter</button>
            </div>
            <div class="card border-secondary">
                <div class="card-body text-center text-muted py-5">
                    Aucune règle définie.
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}