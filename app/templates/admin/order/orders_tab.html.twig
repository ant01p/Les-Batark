{% if orders is empty %}
    <div class="card border-secondary">
        <div class="card-body text-center text-muted py-5">
            Aucune commande pour l'instant.
        </div>
    </div>
{% else %}
    {% set undeliveredOrders = orders|filter(o => not o.delivered) %}
    {% set deliveredOrders = orders|filter(o => o.delivered) %}

    <div class="order-status-section">
        <h3 class="order-status-section-title h5 fw-semibold text-white mb-0">Commandes non livrées</h3>
        {% if undeliveredOrders is empty %}
            <p class="order-status-section-empty">Aucune commande en attente de livraison.</p>
        {% else %}
            <div class="order-cards-masonry" data-controller="order-masonry">
                {% for order in undeliveredOrders %}
                    {% include 'admin/order/_order_card.html.twig' with { order: order, context: 'admin' } %}
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="order-status-section">
        <h3 class="order-status-section-title h5 fw-semibold text-white mb-0">Commandes livrées</h3>
        {% if deliveredOrders is empty %}
            <p class="order-status-section-empty">Aucune commande livrée pour l'instant.</p>
        {% else %}
            <div class="order-cards-masonry" data-controller="order-masonry">
                {% for order in deliveredOrders %}
                    {% include 'admin/order/_order_card.html.twig' with { order: order, context: 'admin' } %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endif %}
